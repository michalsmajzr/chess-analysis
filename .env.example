# Local server settings. Copy this file to .env.local for npm run dev.
OBS_CAMERA_MODE=local
OBS_WEBSOCKET_ENABLED=false
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=
OBS_CAMERA_SCENE=Cameras
OBS_CAMERA_MAP=

# Required only when publishing data to /obs.
BROADCAST_PUBLISHER_TOKEN_HASH=

# Required only when using a local small-board Stockfish container.
STOCKFISH_SMALL_HOST=127.0.0.1
STOCKFISH_SMALL_PORT=5000
STOCKFISH_SMALL_THREADS=2
STOCKFISH_SMALL_HASH=128
